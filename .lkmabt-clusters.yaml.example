# Copy to .lkmabt-clusters.yaml and edit locally. Never commit the copy.
# name       required, unique, [A-Za-z0-9._-]+ ; the report directory name and the
#            identity used by --cluster and in logs. The kflux catalog name is
#            this name with a leading "kflux-" removed and is otherwise
#            unchanged, e.g. name kflux-ocp-p01 is catalog cluster ocp-p01 for
#            the API server host kflux-ocp-p01.7ayg.p1.openshiftapps.com. List
#            catalog names with "kflux cluster list"; an unknown one fails with
#            kflux's "unknown cluster" error.
# type       optional, ocp (default) or roks ; roks logs in with "ibmcloud login --sso"
#            and "ibmcloud ks cluster config" instead of kflux and oc login
# ibmcloud   optional, roks only ; IBM Cloud cluster name or ID passed to
#            "ibmcloud ks cluster config --cluster". Defaults to name.
# ibmcloud-endpoint optional, roks only ; vpe (default), private, or link ; the
#            master endpoint the written kubeconfig points at
# kubeconfig optional, defaults to ~/.kube/config-<catalog> (kflux's own
#            per-cluster path, named from the derived catalog name); "~"
#            expands, relative paths resolve against this file. Every
#            kubeconfig is verified with "oc whoami" before the run; a rejected
#            one is refreshed through kflux or "oc login".
# server     optional API server URL ; omitted means the kubeconfig's own server is used
clusters:
  - name: kflux-ocp-p01
#  - name: kflux-rhel-p01
#    server: https://api.kflux-rhel-p01.example.com:6443
#  - name: kflux-osp-p01
#    kubeconfig: ~/.kube/config-osp-p01
#  - name: kflux-lw-p01
#    type: roks
#    ibmcloud: kflux-lw-p01
#    ibmcloud-endpoint: vpe
