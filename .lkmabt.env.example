# Copy to .lkmabt.env and fill locally. Never commit the copy.
# Cluster selection lives in .lkmabt-clusters.yaml; this file holds provider credentials only.
# GITHUB_TOKEN: optional classic PAT with repo and read:org. Leave it empty to
# authenticate through the gh browser flow; LKMABT deletes the temporary token
# when the run ends.
GITHUB_TOKEN=
GITLAB_BOT_TOKEN=
GITLAB_API_URL=https://gitlab.com/api/v4
